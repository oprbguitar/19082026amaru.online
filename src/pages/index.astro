---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Bookshelf from '../components/Bookshelf.astro';
import StatsBar from '../components/StatsBar.astro';
import ProjectModal from '../components/ProjectModal.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<MainLayout>
  <div class="app-shell" id="app-shell" style={`--paper-image: url('${base}assets/fondo.png')`}>
    <Header />
    <main class="main-stage">
      <Hero />
      <Bookshelf />
    </main>
    <StatsBar />
    <section id="sobre-amaru" class="sr-only" aria-label="Sobre Amaru">Amaru conecta fuentes, proyectos y conocimiento confiable.</section>
    <section id="comunidad" class="sr-only" aria-label="Comunidad">Comunidad Amaru.</section>
    <section id="contacto" class="sr-only" aria-label="Contacto">Contacto Amaru.</section>
    <ProjectModal />
  </div>
</MainLayout>

<script>
  type ProjectData = { id: string; number: string; title: string; description: string; category: string; status: string; keywords: string[]; url?: string };

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-id]'));
  const search = document.querySelector<HTMLInputElement>('#project-search');
  const emptyState = document.querySelector<HTMLElement>('.search-empty');
  const dialog = document.querySelector<HTMLDialogElement>('#project-dialog');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menuClose = document.querySelector<HTMLButtonElement>('.mobile-menu-close');
  const closeDialog = document.querySelector<HTMLButtonElement>('[data-dialog-close]');
  const currentPage = document.querySelector<HTMLElement>('[data-library-current]');
  const previousButton = document.querySelector<HTMLButtonElement>('[data-library-prev]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-library-next]');
  let mobileIndex = 0;
  let lastFocusedElement: HTMLElement | null = null;

  const dataFromCard = (card: HTMLElement): ProjectData => ({
    id: card.dataset.projectId ?? '',
    number: card.querySelector('.card-number')?.textContent?.trim() ?? '',
    title: card.querySelector('.card-title')?.textContent?.trim() ?? '',
    description: card.querySelector('.card-description')?.textContent?.trim() ?? '',
    category: card.dataset.projectCategory ?? '',
    status: card.dataset.projectStatus ?? 'En desarrollo',
    keywords: (card.dataset.projectKeywords ?? '').split('|').filter(Boolean),
    url: card.dataset.projectUrl,
  });

  const updateMobileCard = () => {
    const visibleCards = cards.filter((card) => !card.hidden);
    if (visibleCards.length === 0) {
      if (currentPage) currentPage.textContent = '00';
      return;
    }
    mobileIndex = (mobileIndex + visibleCards.length) % visibleCards.length;
    cards.forEach((card) => {
      card.toggleAttribute('data-mobile-current', card === visibleCards[mobileIndex]);
    });
    if (currentPage) currentPage.textContent = visibleCards[mobileIndex].querySelector('.card-number')?.textContent?.trim() ?? '01';
  };

  const filterCards = (query: string) => {
    const normalizedQuery = query.trim().toLocaleLowerCase('es');
    let matches = 0;
    cards.forEach((card) => {
      const haystack = (card.dataset.projectSearch ?? '').toLocaleLowerCase('es');
      const matchesQuery = !normalizedQuery || haystack.includes(normalizedQuery);
      card.hidden = !matchesQuery;
      if (matchesQuery) matches += 1;
    });
    if (emptyState) emptyState.hidden = matches > 0;
    mobileIndex = 0;
    updateMobileCard();
  };

  const closeMobileMenu = () => {
    if (!menu || !menuToggle) return;
    menu.hidden = true;
    menuToggle.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  };

  const openMobileMenu = () => {
    if (!menu || !menuToggle) return;
    menu.hidden = false;
    menuToggle.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
    menu.querySelector<HTMLAnchorElement>('a')?.focus();
  };

  const openProject = (card: HTMLElement) => {
    const project = dataFromCard(card);
    if (project.url) {
      window.location.assign(project.url);
      return;
    }
    if (!dialog) return;
    lastFocusedElement = document.activeElement as HTMLElement;
    const setText = (selector: string, text: string) => {
      const element = dialog.querySelector<HTMLElement>(selector);
      if (element) element.textContent = text;
    };
    setText('[data-dialog-number]', project.number);
    setText('[data-dialog-title]', project.title);
    setText('[data-dialog-description]', project.description);
    setText('[data-dialog-category]', project.category || 'Biblioteca Amaru');
    setText('[data-dialog-status]', project.status);
    setText('[data-dialog-keywords]', project.keywords.join(' · ') || 'Conocimiento');
    dialog.showModal();
    closeDialog?.focus();
  };

  search?.addEventListener('input', () => filterCards(search.value));
  cards.forEach((card) => card.querySelector<HTMLButtonElement>('.card-hit-area')?.addEventListener('click', () => openProject(card)));
  menuToggle?.addEventListener('click', openMobileMenu);
  menuClose?.addEventListener('click', closeMobileMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobileMenu));
  closeDialog?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => lastFocusedElement?.focus());
  previousButton?.addEventListener('click', () => { mobileIndex -= 1; updateMobileCard(); });
  nextButton?.addEventListener('click', () => { mobileIndex += 1; updateMobileCard(); });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileMenu();
  });
  updateMobileCard();
</script>
