---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<header class="site-header">
  <a class="brand" href={`${base}`} aria-label="Amaru.online, inicio">
    <img src={`${base}assets/logo.png`} alt="" width="54" height="54" />
    <span class="brand-copy">
      <span class="brand-name">Amaru<span>.online</span></span>
      <span class="brand-tagline">Conocimiento que transforma</span>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="Navegación principal">
    <a class="active" href="#inicio">Inicio<span class="nav-mark" aria-hidden="true">◇</span></a>
    <a href="#biblioteca">Proyectos</a>
    <a href="#sobre-amaru">Sobre Amaru</a>
    <a href="#recursos">Recursos</a>
    <a href="#comunidad">Comunidad</a>
    <a href="#contacto">Contacto</a>
  </nav>

  <div class="header-actions">
    <label class="search-control" for="project-search">
      <span class="sr-only">Buscar en la biblioteca</span>
      <input id="project-search" type="search" placeholder="Buscar proyectos, temas o fuentes..." autocomplete="off" />
      <span class="search-icon" aria-hidden="true">⌕</span>
    </label>
    <a class="header-cta" href="#biblioteca"><span class="grid-icon" aria-hidden="true">⊞</span> Explorar biblioteca <span aria-hidden="true">→</span></a>
  </div>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
    <span></span><span></span><span></span>
  </button>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="mobile-menu-head">
      <span>Menú</span>
      <button class="mobile-menu-close" type="button" aria-label="Cerrar menú">×</button>
    </div>
    <nav aria-label="Navegación móvil">
      <a href="#inicio">Inicio</a>
      <a href="#biblioteca">Proyectos</a>
      <a href="#sobre-amaru">Sobre Amaru</a>
      <a href="#recursos">Recursos</a>
      <a href="#comunidad">Comunidad</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <a class="mobile-menu-cta" href="#biblioteca">Explorar biblioteca <span aria-hidden="true">→</span></a>
  </div>
</header>
