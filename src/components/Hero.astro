---
import QuipuDecoration from './QuipuDecoration.astro';
---
<section id="inicio" class="hero-panel" aria-labelledby="hero-title">
  <QuipuDecoration />
  <div class="hero-content">
    <p class="hero-kicker"><span aria-hidden="true">◇</span> Biblioteca Amaru</p>
    <h1 id="hero-title">Navega la<br /><em>biblioteca</em> Amaru</h1>
    <div class="hero-rule" aria-hidden="true"><span></span><b>◇</b><span></span></div>
    <p class="hero-lede">Explora proyectos que recopilan, organizan y visualizan información de internet para impulsar decisiones con conocimiento confiable.</p>

    <div class="principles" aria-label="Principios de Amaru">
      <div class="principle"><span class="principle-icon cyan" aria-hidden="true">✣</span><strong>Información<br />confiable</strong></div>
      <div class="principle"><span class="principle-icon orange" aria-hidden="true">⌁</span><strong>Clasificación<br />inteligente</strong></div>
      <div class="principle"><span class="principle-icon purple" aria-hidden="true">✤</span><strong>Visualización<br />significativa</strong></div>
    </div>

    <div class="hero-actions">
      <a class="text-button" href="#sobre-amaru">Conoce más sobre Amaru <span aria-hidden="true">›</span></a>
    </div>
  </div>
</section>
