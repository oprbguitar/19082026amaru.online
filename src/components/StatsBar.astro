---
import { projectCategories, projects } from '../data/projects';
---
<footer class="stats-bar" id="recursos" aria-label="Información de la biblioteca">
  <div class="stat-item"><span class="stat-symbol green" aria-hidden="true">▥</span><span><strong>{projects.length}</strong><small>Proyectos</small></span></div>
  <div class="stat-item"><span class="stat-symbol orange" aria-hidden="true">◌</span><span><strong>{projectCategories.length}</strong><small>Categorías</small></span></div>
  <div class="stat-item"><span class="stat-symbol purple" aria-hidden="true">✣</span><span><strong>{projects.length}</strong><small>Recursos organizados</small></span></div>
  <div class="stat-item"><span class="stat-symbol gold" aria-hidden="true">▤</span><span><strong>100%</strong><small>Navegación local</small></span></div>
  <div class="stat-item stat-qualitative"><span class="stat-symbol teal" aria-hidden="true">♢</span><span><strong>Seguridad</strong><small>Lectura responsable</small></span></div>
  <div class="stat-item stat-qualitative"><span class="stat-symbol purple" aria-hidden="true">◎</span><span><strong>Actualización</strong><small>Continua</small></span></div>
</footer>
