---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section id="biblioteca" class="library-panel" aria-label="Biblioteca de proyectos">
  <div class="bookshelf-frame" style={`--frame-image: url('${base}assets/box.png')`}>
    <div class="shelf-grid" aria-live="polite">
      {projects.map((project) => <ProjectCard {...project} />)}
      <p class="search-empty" hidden>No encontramos proyectos con esa búsqueda.</p>
    </div>
  </div>
  <div class="mobile-library-controls" aria-label="Controles de proyectos">
    <button class="library-arrow" type="button" data-library-prev aria-label="Proyecto anterior">←</button>
    <span class="library-page" aria-live="polite"><b data-library-current>01</b> / {projects.length.toString().padStart(2, '0')}</span>
    <button class="library-arrow" type="button" data-library-next aria-label="Proyecto siguiente">→</button>
  </div>
</section>
