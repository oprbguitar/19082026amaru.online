<dialog id="project-dialog" class="project-dialog" aria-labelledby="dialog-title">
  <div class="dialog-shell">
    <button class="dialog-close" type="button" data-dialog-close aria-label="Cerrar detalle">×</button>
    <p class="dialog-kicker">Detalle del proyecto</p>
    <span class="dialog-number" data-dialog-number>01</span>
    <h2 id="dialog-title" data-dialog-title>Proyecto</h2>
    <p class="dialog-description" data-dialog-description></p>
    <dl class="dialog-meta">
      <div><dt>Categoría</dt><dd data-dialog-category></dd></div>
      <div><dt>Estado</dt><dd data-dialog-status></dd></div>
      <div><dt>Palabras clave</dt><dd data-dialog-keywords></dd></div>
    </dl>
    <p class="dialog-status-note">Proyecto en desarrollo · La biblioteca crecerá con nuevas conexiones.</p>
  </div>
</dialog>
